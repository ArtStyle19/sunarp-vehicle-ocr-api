# Copy to .env and fill in. Never commit the real .env or any service-account JSON.

# --- Authentication between n8n and this service -------------------------------------------
# Shared secret n8n sends in the X-API-Key header. Generate with: openssl rand -hex 32
API_KEY=change-me

# --- Google Drive ---------------------------------------------------------------------------
# Path to the read-only service-account key INSIDE the container. The file is mounted at
# runtime; it is never baked into the image and never committed.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json

# --- Service ---------------------------------------------------------------------------------
LOG_LEVEL=INFO

# Returns raw OCR text, tokens and column geometry in the response. Development only.
RETURN_DEBUG_DATA=false

# --- OCR --------------------------------------------------------------------------------------
# Spanish is what these documents are in. "spa+eng" also works but is not required.
OCR_LANG=spa
OCR_TIMEOUT_SECONDS=120

# Render scale is chosen adaptively so glyphs land near this height in pixels. See the README:
# a fixed 300 DPI measurably degrades these 72 ppi scans.
OCR_TARGET_TOKEN_HEIGHT_PX=26
OCR_PROBE_SCALE=1.5
OCR_MIN_SCALE=1.5
OCR_MAX_SCALE=4.0

# --- Limits -------------------------------------------------------------------------------------
MAX_PDF_BYTES=26214400
MAX_OCR_PAGES=3
# OCR is CPU-bound; the MVP processes one document at a time.
MAX_CONCURRENT_EXTRACTIONS=1
